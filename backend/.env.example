# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/imovies

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed by CORS (enforced when NODE_ENV=production)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Business rules
TZ_OFFSET_MINUTES=330        # cinema time zone as minutes from UTC (330 = IST)
BOOKING_FEE=20               # rupees per seat
MAX_SEATS=8                  # seats per booking
HOLD_MINUTES=7               # how long selected seats are held while paying
CANCEL_CUTOFF_MINUTES=60     # users cannot cancel inside this window before the show

# Used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@imovies.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=user@imovies.test
SEED_USER_PASSWORD=User@12345
